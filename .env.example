GEMINI_API_KEY=

# Optional overrides
# LIVE_MODEL=gemini-3.8-live
# LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview
# TEXT_MODEL=gemini-3.5-flash-lite
# BACKGROUND_MODEL=gemini-3.1-flash-lite
